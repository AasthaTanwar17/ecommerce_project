    {
      "name": "b1864d1b",
      "displayName": "Customer_performance",
      "queryLines": [
        "select \r\n",
        "    cg.customer_id, \r\n",
        "    cg.total_spend, \r\n",
        "    cg.order_count,\r\n",
        "    cs.customer_name,\r\n",
        "    cs.city\r\n",
        "from customer_performance_gold cg\r\n",
        "inner join ecommerce_project.silver_ecom.customers_silver cs\r\n",
        "on cg.customer_id = cs.customer_id\r\n",
        "order by cg.order_count desc\r\n"
      ],
      "catalog": "ecommerce_project",
      "schema": "gold_ecom"
    },
    {
      "name": "510585a6",
      "displayName": "top_5_products",
      "queryLines": [
        "select * from product_performance_gold\r\n",
        "order by product_revenue desc\r\n",
        "limit 5"
      ],
      "catalog": "ecommerce_project",
      "schema": "gold_ecom"
    },
    {
      "name": "276be23a",
      "displayName": "Customer_performance 1",
      "queryLines": [
        "select \r\n",
        "    cg.customer_id, \r\n",
        "    cg.total_spend, \r\n",
